// {description}
// Generated by generate_sweep.py — DO NOT edit manually
// Sweep variable: {sweep_var} = {sweep_val}

cellsize := {cellsize}
Ms_val   := {Ms_val}
A_base   := {A_base}

SetGridSize({Nx}, {Ny}, {Nz})
SetCellSize(cellsize, cellsize, cellsize)
SetPBC({PBC_x}, {PBC_y}, {PBC_z})

Msat        = Ms_val
Aex         = A_base
Dbulk       = 0
Dind        = 0
Ku1         = {Ku1}
{anisU_line}EnableDemag = {EnableDemag}
alpha       = {alpha}

// J4: fourth-nearest-neighbor (distance 2a, 6 directions)
A_J4     := A_base * ({J4_ratio})
Coeff_J4 := A_J4 * 2.0 / (Ms_val * cellsize * cellsize)
sum_J4   := Add(Shifted(m,  2, 0, 0), Shifted(m, -2, 0, 0))
sum_J4    = Add(sum_J4, Shifted(m, 0,  2, 0))
sum_J4    = Add(sum_J4, Shifted(m, 0, -2, 0))
sum_J4    = Add(sum_J4, Shifted(m, 0, 0,  2))
sum_J4    = Add(sum_J4, Shifted(m, 0, 0, -2))
AddFieldTerm(Mul(Const(Coeff_J4), sum_J4))

// J2: next-nearest-neighbor (distance sqrt(2)*a, 12 directions)
A_J2     := A_base * ({J2_ratio})
Coeff_J2 := A_J2 * 2.0 / (Ms_val * cellsize * cellsize)
sum_J2   := Add(Shifted(m,  1,  1, 0), Shifted(m,  1, -1, 0))
sum_J2    = Add(sum_J2, Shifted(m, -1,  1, 0))
sum_J2    = Add(sum_J2, Shifted(m, -1, -1, 0))
sum_J2    = Add(sum_J2, Shifted(m,  0,  1,  1))
sum_J2    = Add(sum_J2, Shifted(m,  0,  1, -1))
sum_J2    = Add(sum_J2, Shifted(m,  0, -1,  1))
sum_J2    = Add(sum_J2, Shifted(m,  0, -1, -1))
sum_J2    = Add(sum_J2, Shifted(m,  1,  0,  1))
sum_J2    = Add(sum_J2, Shifted(m,  1,  0, -1))
sum_J2    = Add(sum_J2, Shifted(m, -1,  0,  1))
sum_J2    = Add(sum_J2, Shifted(m, -1,  0, -1))
AddFieldTerm(Mul(Const(Coeff_J2), sum_J2))

{extra_setup}m.LoadFile("{LoadFile}")

autosave(m, {autosave})
tableautosave({tableautosave})
TableAdd(E_Total)
run({run_time})
