sum_J2 = Add(sum_J2, Shifted(m, 1, 0, 1))
sum_J2 = Add(sum_J2, Shifted(m, 1, 0, -1))
sum_J2 = Add(sum_J2, Shifted(m, -1, 0, 1))
sum_J2 = Add(sum_J2, Shifted(m, -1, 0, -1))
AddFieldTerm(Mul(Const(Coeff_J2), sum_J2))
m.LoadFile("/mnt/d/Research/Hopfion/20260105_frustrated_fm/centered_stability_test/stability_Ku10k.out/m000020.ovf")
