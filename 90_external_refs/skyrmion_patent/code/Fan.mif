# MIF 2.2
#



set pi [expr {4*atan(1.0)}]
set mu0 [expr {4*$pi*1e-7}]
set utop [expr {2e7}]
set ubottom [expr {1.5e7}]


Parameter cellsize_x 1e-9
Parameter cellsize_y 1e-9
Parameter cellsize_z 1e-9
Parameter region_width   1e-9
Parameter region_period  1e-9
Parameter region_count   10

set xmax [expr {($region_count-1)*$region_period + $region_width}]
set ymax [expr {($region_count-1)*$region_period + $region_width}]
set zmax 2e-9

set zmid 1e-9

# Use a Tcl for-loop to construct a string representing list of regions.
# This string is imported into the Oxs_MultiAtlas Specify block to
# define the regions.
for {set i 0} {$i<$region_count} {incr i} {
    set atlas_string_bottom [subst {Oxs_BoxAtlas {
          xrange {[expr {$i*$region_period}]
                  [expr {$i*$region_period+$region_width}]}
          yrange {0 $ymax}
          zrange {0 $zmid}
          name   {region_bottom_$i}
     }}]
     lappend regions_list "atlas" $atlas_string_bottom
}

for {set j 0} {$j<$region_count} {incr j} {
    set atlas_string_top [subst {Oxs_BoxAtlas {
          xrange {[expr {$j*$region_period}]
                  [expr {$j*$region_period+$region_width}]}
          yrange {0 $ymax}
          zrange {$zmid $zmax}
          name   {region_top_$j}
     }}]
     lappend regions_list "atlas" $atlas_string_top
}

Specify Oxs_MultiAtlas:atlas [subst {
  $regions_list
  xrange {0 $xmax}
  yrange {0 $ymax}
  zrange {0 $zmax}
}]

Specify Oxs_RectangularMesh:mesh [subst {
  cellsize {$cellsize_x $cellsize_y $cellsize_z}
  atlas :atlas
}]

#下层各向异性
set K_bottom_list {}
for {set asd 0} {$asd<$region_count} {incr asd} {
lappend K_bottom_list region_bottom_$asd 1.0e6
}

Specify Oxs_UniaxialAnisotropy [subst {
   K1  { Oxs_AtlasScalarField {
      atlas :atlas
      default_value 1.5e6
      values [list $K_bottom_list]
   }}
   axis {0 0 1}
}]

set A_start -50e-13
set A_end -5e-13
set A_slope [expr {($A_end-$A_start)/($region_count-1)}]
# Exchange
set A_list {}
for {set i 0} {$i<$region_count} {incr i} {
set A_value [expr {$A_start+$A_slope*$i}]
lappend A_list region_bottom_$i region_top_$i $A_value
}

# Specify Oxs_Exchange6Ngbr [subst {
# default_A $A
# atlas world
# A [list $A_list]
# }]
Specify Oxs_Exchange6Ngbr [subst {
  default_A 5e-12
  atlas :atlas
  A [list $A_list]

}]

Specify Oxs_Demag {}

#######以下代码是加电流###############
Specify Oxs_SpinXferEvolve:evolve [subst {
 alpha 0.2
 J -12e12
 mp {1 0 0}
 P 0.4
 Lambda 2
 J_profile J_time
 J_profile_args total_time
}]
Parameter tstart 0.0e-9
Parameter tstop 0.015e-9
proc J_time { t } {
   global tstart
   global tstop
    set scale 0.0;
    if {($t > $tstart) && ($t < $tstop)} {
        set scale 1.0
    }
    return $scale
}

Specify Oxs_TimeDriver {
 evolver :evolve
 stopping_time 40e-9
 mesh :mesh
 Ms 1.1e6
 m0 { Oxs_FileVectorField {
    atlas :atlas
    file "./state2.omf"
 }}
}

