//output directory: run_neel_hopfion_v4.out/
//starting GUI at http://127.0.0.1:35367
Nx := 128
Ny := 128
Nz := 16
SetGridSize(Nx, Ny, Nz)
SetCellSize(0.5e-9, 0.5e-9, 0.5e-9)
SetGeom(Cylinder(64e-9, 8e-9))
// Initializing geometry 0 %
// Initializing geometry 100 %
Msat = 3e5
Aex = 1.1e-12
Dind = 1.15e-3
Ku1 = 1e6
anisU = vector(0, 0, 1)
B_ext = vector(0, 0, -0.3)
m.LoadFile("neel_hopfion_init_r3.ovf")
TableAdd(E_Total)
TableAdd(E_demag)
tableautosave(1e-12)
autosave(m, 2e-11)
alpha = 0.001
Run(0.1e-9)
//Using cached kernel: /tmp/mumax3kernel_[128 128 16]_[0 0 0]_[5e-10 5e-10 5e-10]_6_
Print("Stage1 done: alpha=0.001, 0.1ns")
//Stage1 done: alpha=0.001, 0.1ns
alpha = 0.01
Run(0.1e-9)
Print("Stage2 done: alpha=0.01, 0.1ns")
//Stage2 done: alpha=0.01, 0.1ns
alpha = 0.1
Run(0.1e-9)
Print("Stage3 done: alpha=0.1, 0.1ns")
//Stage3 done: alpha=0.1, 0.1ns
alpha = 0.5
Run(0.2e-9)
Print("Stage4 done: alpha=0.5, 0.2ns")
//Stage4 done: alpha=0.5, 0.2ns
saveas(m, "neel_hopfion_adiabatic_relaxed")
alpha = 0.02
Run(2e-9)
saveas(m, "neel_hopfion_final")
