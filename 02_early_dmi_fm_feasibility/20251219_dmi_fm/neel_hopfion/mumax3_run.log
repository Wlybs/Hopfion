//output directory: run_neel_hopfion.out/
//starting GUI at http://127.0.0.1:35367
Nx := 128
Ny := 128
Nz := 16
SetGridSize(Nx, Ny, Nz)
SetCellSize(0.5e-9, 0.5e-9, 0.5e-9)
SetGeom(Cylinder(64e-9, 8e-9))
// Initializing geometry 0 %
// Initializing geometry 100 %
Msat = 3e5
Aex = 1.1e-12
Dind = 1.15e-3
Ku1 = 1e6
anisU = vector(0, 0, 1)
B_ext = vector(0, 0, -0.12)
m.LoadFile("neel_hopfion_init.ovf")
TableAdd(E_Total)
TableAdd(E_demag)
tableautosave(1e-12)
alpha = 0.5
Relax()
//Did not use cached kernel: open /tmp/mumax3kernel_[128 128 16]_[0 0 0]_[5e-10 5e-10 5e-10]_6_0 0.ovf: no such file or directory
// Calculating demag kernel 0 %
// Calculating demag kernel 100 %
//Cached kernel: /tmp/mumax3kernel_[128 128 16]_[0 0 0]_[5e-10 5e-10 5e-10]_6_
saveas(m, "neel_hopfion_relax")
alpha = 0.02
autosave(m, 2e-11)
Run(2e-9)
saveas(m, "neel_hopfion_final")
