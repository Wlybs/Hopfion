// 测试: B_ext=0, 长时间演化，找 Ku+DMI 稳定的基态
// 参数: Msat=3e5, Aex=1.1e-12, Dind=1.15e-3, Ku1=1e6
// 几何: 64nm × 8nm disc
Nx := 128; Ny := 128; Nz := 16
SetGridSize(Nx, Ny, Nz)
SetCellSize(0.5e-9, 0.5e-9, 0.5e-9)
SetGeom(Cylinder(64e-9, 8e-9))
Msat = 3e5; Aex = 1.1e-12; Dind = 1.15e-3; Ku1 = 1e6
anisU = vector(0, 0, 1)
m.LoadFile("neel_hopfion_sutcliffe.ovf")
TableAdd(E_Total); tableautosave(1e-12)
alpha = 0.5
autosave(m, 5e-11)
Relax()
saveas(m, "no_field_relax")
