Nx := 128; Ny := 128; Nz := 16
SetGridSize(Nx, Ny, Nz)
SetCellSize(0.5e-9, 0.5e-9, 0.5e-9)
SetGeom(Cylinder(64e-9, 8e-9))
Msat = 3e5; Aex = 1.1e-12; Dind = 1.15e-3; Ku1 = 1e6
anisU = vector(0, 0, 1)
// B_ext = 0 (对称：mz=+1 与 mz=-1 等价)
m.LoadFile("neel_hopfion_sutcliffe.ovf")
TableAdd(E_Total); tableautosave(2e-12)
alpha = 0.1
autosave(m, 5e-12)
Run(0.05e-9)
saveas(m, "test_no_field_result")
