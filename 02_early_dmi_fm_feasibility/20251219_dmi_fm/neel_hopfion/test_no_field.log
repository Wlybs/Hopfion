//output directory: test_no_field.out/
//starting GUI at http://127.0.0.1:35367
Nx := 128
Ny := 128
Nz := 16
SetGridSize(Nx, Ny, Nz)
SetCellSize(0.5e-9, 0.5e-9, 0.5e-9)
SetGeom(Cylinder(64e-9, 8e-9))
// Initializing geometry 0 %
// Initializing geometry 100 %
Msat = 3e5
Aex = 1.1e-12
Dind = 1.15e-3
Ku1 = 1e6
anisU = vector(0, 0, 1)
m.LoadFile("neel_hopfion_sutcliffe.ovf")
TableAdd(E_Total)
tableautosave(2e-12)
alpha = 0.1
autosave(m, 5e-12)
Run(0.05e-9)
//Using cached kernel: /tmp/mumax3kernel_[128 128 16]_[0 0 0]_[5e-10 5e-10 5e-10]_6_
saveas(m, "test_no_field_result")
