// 测试: alpha=0.001 近保守极限，看 Hopfion 是否稳定
Nx := 128; Ny := 128; Nz := 16
SetGridSize(Nx, Ny, Nz)
SetCellSize(0.5e-9, 0.5e-9, 0.5e-9)
SetGeom(Cylinder(64e-9, 8e-9))
Msat = 3e5; Aex = 1.1e-12; Dind = 1.15e-3; Ku1 = 1e6
anisU = vector(0, 0, 1)
B_ext = vector(0, 0, -0.3)
m.LoadFile("neel_hopfion_init_r3.ovf")
TableAdd(E_Total); tableautosave(1e-12)
alpha = 0.001
autosave(m, 2e-12)
Run(0.05e-9)
saveas(m, "test_conservative_final")
