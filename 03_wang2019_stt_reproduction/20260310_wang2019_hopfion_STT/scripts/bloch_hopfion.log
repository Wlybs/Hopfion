//output directory: run_bloch_hopfion.out/
//starting GUI at http://127.0.0.1:35367
Nx := 256
Ny := 256
Nz := 32
SetGridSize(Nx, Ny, Nz)
SetCellSize(0.5e-9, 0.5e-9, 0.5e-9)
SetPBC(1, 0, 0)
//resizing...
Msat = 1.51e5
Aex = 0.16e-12
Kbulk := 41e3
Ku1 = Kbulk
anisU = vector(0, 0, 1)
Dbulk = 0.115e-3
Ks_extra := 1e6
DefRegion(1, Layers(0, 0))
DefRegion(2, Layers(Nz-1, Nz-1))
Ku1.SetRegion(1, Kbulk+Ks_extra)
Ku1.SetRegion(2, Kbulk+Ks_extra)
m.LoadFile("../init_states/wang_bloch_hopfion_init.ovf")
TableAdd(E_Total)
TableAdd(E_demag)
tableautosave(1e-12)
alpha = 1.0
autosave(m, 2e-11)
Run(1e-9)
//Did not use cached kernel: open /tmp/mumax3kernel_[256 256 32]_[1 0 0]_[5e-10 5e-10 5e-10]_6_0 0.ovf: no such file or directory
// Calculating demag kernel 0 %
// Calculating demag kernel 100 %
//Cached kernel: /tmp/mumax3kernel_[256 256 32]_[1 0 0]_[5e-10 5e-10 5e-10]_6_
saveas(m, "bloch_hopfion_relaxed")
alpha = 0.05
autosave(m, 5e-11)
Run(2e-9)
saveas(m, "bloch_hopfion_stable")
