// Wang 2019 PRL — Néel Hopfion 稳定化
// 参数: Aex=0.16pJ/m, Ms=1.51e5, Ks=0.5mJ/m²(surface), Kb=20kJ/m³, Di=0.115mJ/m²
// 几何: 128nm × 128nm × 16nm, cell=0.5nm, PBC in x

Nx := 256; Ny := 256; Nz := 32
SetGridSize(Nx, Ny, Nz)
SetCellSize(0.5e-9, 0.5e-9, 0.5e-9)
SetPBC(1, 0, 0)   // x 方向 PBC（纳米带）

// 材料参数 (Wang 2019, MnSi-like, Néel 型)
Msat  = 1.51e5        // A/m
Aex   = 0.16e-12      // J/m
Kbulk := 20e3         // J/m³ (Néel 型体各向异性，比 Bloch 型弱)
Ku1   = Kbulk
anisU = vector(0, 0, 1)

// 界面 DMI（Néel 型）
Dind = 0.115e-3       // J/m²

// 表面各向异性 Ks=0.5mJ/m² → Ku1_extra = Ks/dz
Ks_extra := 1e6

DefRegion(1, Layers(0, 0))       // 底层
DefRegion(2, Layers(Nz-1, Nz-1)) // 顶层
Ku1.SetRegion(1, Kbulk + Ks_extra)
Ku1.SetRegion(2, Kbulk + Ks_extra)

// 加载 Wang ansatz 初始态
m.LoadFile("../init_states/wang_neel_hopfion_init.ovf")

TableAdd(E_Total)
TableAdd(E_demag)
tableautosave(1e-12)

// 阶段1：高阻尼弛豫
alpha = 1.0
autosave(m, 2e-11)
Run(1e-9)
saveas(m, "neel_hopfion_relaxed")

// 阶段2：低阻尼验证稳定性
alpha = 0.05
autosave(m, 5e-11)
Run(2e-9)
saveas(m, "neel_hopfion_stable")
