% hduthesis.sty — 杭州电子科技大学本科毕业论文 LaTeX 格式包
% 基于杭电 2026 届毕设模板规范（参考 01-论文.pdf 提取条款）
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{hduthesis}[2026/04/14 HDU Undergraduate Thesis Style v2]

%% ========== 基础宏包 ==========
\RequirePackage{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{titletoc}
\RequirePackage{setspace}
\RequirePackage{graphicx}
\RequirePackage{caption}
\RequirePackage{subcaption}
\RequirePackage{booktabs}
\RequirePackage{amsmath,amssymb,amsfonts}
\RequirePackage{siunitx}
\RequirePackage{hyperref}
\RequirePackage{cleveref}
\RequirePackage{enumitem}
\RequirePackage{xcolor}
\RequirePackage{tabularx}
\RequirePackage{float}
\RequirePackage[backend=biber,style=gb7714-2015,gbpub=false]{biblatex}

%% ========== 英文字体：Times New Roman ==========
\setmainfont{Times New Roman}

%% ========== 页面设置（A4，上3/下2/左3/右2 cm，装订线1cm）==========
\geometry{
  a4paper,
  top           = 3cm,
  bottom        = 2cm,
  left          = 3cm,
  right         = 2cm,
  bindingoffset = 1cm,
  headheight    = 14pt,
  headsep       = 0.5cm,
  footskip      = 1.75cm
}

%% ========== 行距：正文固定 20 磅（≈ linespread 1.389 for 小四）==========
\linespread{1.389}

%% ========== 页眉页脚样式 ==========
% 规范页眉："杭州电子科技大学本科毕业设计（论文）" 宋体五号，居中
% 规范前置页页码：罗马数字；正文页码：阿拉伯数字；字号约小五（9pt）

% mainmatter：正文样式（页眉+阿拉伯页码）
\fancypagestyle{mainmatter}{%
  \fancyhf{}%
  \fancyhead[C]{\songti\zihao{5} 杭州电子科技大学本科毕业设计（论文）}%
  \fancyfoot[C]{\zihao{-5} -~\thepage~-}%
  \renewcommand{\headrulewidth}{0.4pt}%
  \renewcommand{\footrulewidth}{0pt}%
}

% romanfront：前置页样式（页眉+罗马页码），用于中文摘要/英文摘要/目录
\fancypagestyle{romanfront}{%
  \fancyhf{}%
  \fancyhead[C]{\songti\zihao{5} 杭州电子科技大学本科毕业设计（论文）}%
  \fancyfoot[C]{\zihao{-5} \thepage}%
  \renewcommand{\headrulewidth}{0.4pt}%
  \renewcommand{\footrulewidth}{0pt}%
}

% bareempty：封面和诚信承诺书（无页眉无页码）
\fancypagestyle{bareempty}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
}

% 默认样式 = mainmatter
\pagestyle{mainmatter}

%% ========== 章节标题格式 ==========
% 一级（章）：黑体三号，居中，单倍行距，段前2行(≈40pt)，段后2行(≈40pt)
%            格式 "1  标题"（不带"第X章"）
% 二级（节）：黑体四号，靠左顶格，单倍行距
% 三级（小节）：黑体小四号（规范明确），靠左顶格
\ctexset{
  chapter = {
    format       = \centering\heiti\zihao{3}\linespread{1.0}\selectfont,
    name         = {,},
    number       = \arabic{chapter},
    aftername    = \hspace{1em},
    beforeskip   = 40pt,
    afterskip    = 40pt,
    fixskip      = true,
  },
  section = {
    format     = \heiti\zihao{4}\linespread{1.0}\selectfont,
    aftername  = \hspace{1em},
    beforeskip = 24pt,
    afterskip  = 12pt,
    indent     = 0pt,
  },
  subsection = {
    format     = \heiti\zihao{-4}\linespread{1.0}\selectfont,
    aftername  = \hspace{1em},
    beforeskip = 12pt,
    afterskip  = 6pt,
    indent     = 0pt,
  },
}

%% ========== 目录格式 ==========
% 规范：目录内容中文宋体小四，英文 TNR 小四；至少列到二级
\setcounter{tocdepth}{1}

\titlecontents{chapter}
  [0em]
  {\songti\zihao{-4}\vspace{6pt}}
  {\thecontentslabel\hspace{1em}}
  {}
  {\titlerule*[0.5em]{.}\contentspage}

\titlecontents{section}
  [2em]
  {\songti\zihao{-4}}
  {\thecontentslabel\hspace{1em}}
  {}
  {\titlerule*[0.5em]{.}\contentspage}

% 目录标题：黑体三号，居中，段前2行段后2行
\makeatletter
\renewcommand{\tableofcontents}{%
  \clearpage
  \thispagestyle{romanfront}%
  \vspace*{40pt}%
  {\par\centering\heiti\zihao{3}\linespread{1.0}\selectfont 目\hspace{1em}录\par}%
  \vspace{40pt}%
  \@starttoc{toc}%
}
\makeatother

%% ========== 图表编号（X-Y 格式）==========
\counterwithin{figure}{chapter}
\counterwithin{table}{chapter}
\counterwithin{equation}{chapter}
\renewcommand{\thefigure}{\thechapter-\arabic{figure}}
\renewcommand{\thetable}{\thechapter-\arabic{table}}
\renewcommand{\theequation}{\thechapter-\arabic{equation}}

%% ========== 图表标题：宋体五号，居中 ==========
% 图题在下方；表题在上方
\DeclareCaptionFont{songti}{\songti}
\captionsetup{
  font          = {small, songti},
  labelsep      = space,
  justification = centering,
  format        = plain
}
\captionsetup[figure]{position=bottom, name={图}}
\captionsetup[table]{position=top,    name={表}}

%% ========== hyperref ==========
\hypersetup{
  colorlinks        = true,
  linkcolor         = black,
  citecolor         = black,
  urlcolor          = blue,
  bookmarksnumbered = true,
  pdfstartview      = FitH
}

%% ========== cleveref 中文 ==========
\crefname{figure}{图}{图}
\crefname{table}{表}{表}
\crefname{equation}{式}{式}
\crefname{chapter}{第}{第}
\crefformat{chapter}{第#2#1#3章}

%% ========== 特殊章节标题命令 ==========
% 规范：黑体三号字，居中，单倍行距，段前2行，段后2行
% 用于：中文摘要、目录、致谢、参考文献
\newcommand{\hduchapterstar}[1]{%
  \clearpage
  \vspace*{40pt}%
  \phantomsection
  {\par\centering\heiti\zihao{3}\linespread{1.0}\selectfont #1\par}%
  \vspace{40pt}%
}

% 英文版：Times New Roman 加黑三号字
\newcommand{\hduchapterstarEn}[1]{%
  \clearpage
  \vspace*{40pt}%
  \phantomsection
  {\par\centering\bfseries\zihao{3}\linespread{1.0}\selectfont #1\par}%
  \vspace{40pt}%
}

%% ========== 中文摘要 ==========
% 标题"摘 要"：黑体三号居中；内容：宋体小四；行距 20 磅
\newenvironment{cnabstract}{%
  \hduchapterstar{摘\hspace{1em}要}%
  \addcontentsline{toc}{chapter}{摘要}%
  \songti\zihao{-4}%
}{%
  \par\vspace{12pt}%
}

% 关键词：标签"关键词："黑体小四；内容宋体小四
\newcommand{\cnkeywords}[1]{%
  \par\vspace{6pt}%
  \noindent{\heiti\zihao{-4}关键词：}{\songti\zihao{-4}#1}%
}

%% ========== 英文摘要 ==========
% ABSTRACT 标题：TNR 加黑三号居中；内容：TNR 小四
\newenvironment{enabstract}{%
  \hduchapterstarEn{ABSTRACT}%
  \addcontentsline{toc}{chapter}{ABSTRACT}%
  \normalfont\zihao{-4}%
}{%
  \par\vspace{12pt}%
}

% Keywords：标签 TNR 加黑小四；内容 TNR 小四
\newcommand{\enkeywords}[1]{%
  \par\vspace{6pt}%
  \noindent{\bfseries\zihao{-4}Keywords:\enspace}{\normalfont\zihao{-4}#1}%
}

%% ========== 致谢 ==========
\newenvironment{acknowledgements}{%
  \hduchapterstar{致\hspace{1em}谢}%
  \addcontentsline{toc}{chapter}{致谢}%
  \songti\zihao{-4}%
}{}

%% ========== 参考文献标题 ==========
\defbibheading{bibliography}[\bibname]{%
  \hduchapterstar{参考文献}%
  \addcontentsline{toc}{chapter}{参考文献}%
}

%% ========== 诚信承诺书环境 ==========
% 规范 P10：标题"诚 信 承 诺"黑体18pt，正文宋体14pt
\newenvironment{commitment}[1][]{%
  \clearpage
  \thispagestyle{bareempty}%
  \vspace*{60pt}%
  {\par\centering\heiti\zihao{2} 诚\hspace{1em}信\hspace{1em}承\hspace{1em}诺\par}%
  \vspace{40pt}%
  \songti\zihao{4}%
  \setlength{\parindent}{2em}%
}{%
  \par\vspace{60pt}%
}

\endinput
