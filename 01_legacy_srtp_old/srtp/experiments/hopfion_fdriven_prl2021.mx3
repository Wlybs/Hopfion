// file: hopfion_fdriven_prl2021.mx3
// Purpose: Field-driven spin-wave modes of a Bloch-type hopfion (bulk DMI) with sinc excitation.
// Based on reported parameters for a chiral magnet used to study resonances.

// ---------- Mesh ----------
SetGridsize(256, 256, 64)
SetCellsize(2e-9, 2e-9, 2e-9)
SetPBC(0,0,0)

// ---------- Material parameters ----------
Msat = 384e3       // A/m
Aex  = 2.19e-12    // J/m
Dbulk = 0.395e-3   // J/m^2
alpha = 0.001
gammaLL = 2.211e5

// Tiny perpendicular anisotropy to stabilize boundaries
Ku1 = 5e3
anisU = vector(0,0,1)

// ---------- Geometry ----------
defRegion(1, cylinder(256e-9/2))
setgeom(region(1))

// ---------- Hopfion initialization (Bloch-type) ----------
R0 := 120e-9
r0 := 35e-9
func theta(ρ float64) float64 { return Pi * 0.5 * (1 - tanh((ρ - r0)/(0.25*r0))) } // smooth wall
func phi(x,y float64) float64 { return atan2(y, x) }
func hopfion(m *data.Vector, r *data.Vector) {
    x := r.X(); y := r.Y(); z := r.Z()
    ρ := sqrt( pow( sqrt(x*x+y*y) - R0, 2 ) + z*z ) + 1e-18
    th := theta(ρ)
    ph := phi(x,y)
    // Bloch-type tube twist:
    mx :=  cos(ph)*sin(th)
    my :=  sin(ph)*sin(th)
    mz :=  cos(th)
    m.Set(mx, my, mz)
}
m.Set(hopfion)
relax()

// ---------- Static bias field ----------
B0 := 0.05        // 50 mT
B_ext = vector(0,0,B0)

// ---------- Broadband excitation: sinc pulse along x ----------
fmax := 15e9          // 15 GHz
t0 := 1.0/fmax
B1 := 1e-3            // 1 mT amplitude
exc := func(t float64) float64 { return B1 * sinc(2*Pi*fmax*(t - t0)) }
autosave(m, 1e-10)
tablesave()
run(0) // ensure state saved

// Time evolution with drive
steps := 40000
dt := 2.5e-12        // 2.5 ps -> covers 100 ns window
for i:=0; i<steps; i++ {
    B_ext = vector(exc(Time), 0, B0)
    run(dt)
    tablesave()
}

// ---------- Output ----------
saveas(m, "m_modes.omf")
saveas(E_total, "E_modes.txt")
