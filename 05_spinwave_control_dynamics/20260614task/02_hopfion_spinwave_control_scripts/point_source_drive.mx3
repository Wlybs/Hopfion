// === Spin-Wave Driven Hopfion: Point Source (basic example) ===
// A single-cell point source at x = -10 nm emits a spin wave that drives a
// centered Hopfion. Point-source counterpart of plane_wave_drive.mx3.
//
// ── Parameter summary ──────────────────────────────────────────────
//   Geometry   : 100^3 cells, 0.5 nm/cell (50 nm cube)
//   Field setup: demag OFF, no PBC; 6-face 5-cell absorbing layer (alpha=100),
//                bulk alpha=0.001
//   Material   : Ms=1.5e5 A/m, Aex(J1)=5e-12 J/m, Ku1=1e4 J/m^3 (easy-axis z)
//   Frustration: J2=-0.164*J1 (12 NNN), J4=-0.082*J1 (6 4th-NN)
//   Init state : initial_hopfion.ovf  (frustrated-FM Hopfion, Q_H=1)
//   Source     : single cell (30,50,50) at x=-10 nm, B=500*sin(2*pi*f*t) along x
//   Frequency  : 440 GHz
//   Output     : OVF every 50 ps, table every 10 ps; run 0.3 ns
// ───────────────────────────────────────────────────────────────────

CellSize := 0.5e-9
SetGridSize(100, 100, 100)
SetCellSize(CellSize, CellSize, CellSize)

// Absorbing boundary regions (5-cell thick slabs on all 6 faces)
DefRegion(1, XRange(22.5e-9, 25e-9))
DefRegion(2, XRange(-25e-9, -22.5e-9))
DefRegion(3, YRange(22.5e-9, 25e-9))
DefRegion(4, YRange(-25e-9, -22.5e-9))
DefRegion(5, ZRange(22.5e-9, 25e-9))
DefRegion(6, ZRange(-25e-9, -22.5e-9))

// Point source: single cell at x = -10 nm, grid index (30, 50, 50)
DefRegionCell(7, 30, 50, 50)

EnableDemag = false

// ── Frustrated FM parameters ──
Ms     := 1.5e5
Msat    = Ms
A_base := 5e-12
Aex     = A_base
Dbulk   = 0
Dind    = 0
Ku1     = 1e4
anisU   = vector(0, 0, 1)

// Damping: low in bulk, strongly absorbing at boundaries
alpha = 0.001
alpha.setRegion(1, 100)
alpha.setRegion(2, 100)
alpha.setRegion(3, 100)
alpha.setRegion(4, 100)
alpha.setRegion(5, 100)
alpha.setRegion(6, 100)

// ── J4: 4th nearest-neighbor (6 neighbors at 2a) ──
A_J4     := A_base * (-0.082)
Coeff_J4 := A_J4 * 2.0 / (Ms * CellSize * CellSize)
sum_J4   := Add(Shifted(m, 2, 0, 0), Shifted(m, -2, 0, 0))
sum_J4    = Add(sum_J4, Shifted(m, 0, 2, 0))
sum_J4    = Add(sum_J4, Shifted(m, 0, -2, 0))
sum_J4    = Add(sum_J4, Shifted(m, 0, 0, 2))
sum_J4    = Add(sum_J4, Shifted(m, 0, 0, -2))
AddFieldTerm(Mul(Const(Coeff_J4), sum_J4))

// ── J2: Next-nearest-neighbor (12 neighbors at sqrt(2)*a) ──
A_J2     := A_base * (-0.164)
Coeff_J2 := A_J2 * 2.0 / (Ms * CellSize * CellSize)
sum_J2   := Add(Shifted(m, 1, 1, 0), Shifted(m, 1, -1, 0))
sum_J2    = Add(sum_J2, Shifted(m, -1, 1, 0))
sum_J2    = Add(sum_J2, Shifted(m, -1, -1, 0))
sum_J2    = Add(sum_J2, Shifted(m, 0, 1, 1))
sum_J2    = Add(sum_J2, Shifted(m, 0, 1, -1))
sum_J2    = Add(sum_J2, Shifted(m, 0, -1, 1))
sum_J2    = Add(sum_J2, Shifted(m, 0, -1, -1))
sum_J2    = Add(sum_J2, Shifted(m, 1, 0, 1))
sum_J2    = Add(sum_J2, Shifted(m, 1, 0, -1))
sum_J2    = Add(sum_J2, Shifted(m, -1, 0, 1))
sum_J2    = Add(sum_J2, Shifted(m, -1, 0, -1))
AddFieldTerm(Mul(Const(Coeff_J2), sum_J2))

// ── Load centered equilibrated Hopfion (Q_H=1, Ku=10k, 1 ns relaxed) ──
m.LoadFile("./initial_hopfion.ovf")

// ── Spin wave: B along x, 440 GHz, from the single-cell point source ──
// Point source needs a large local amplitude to inject comparable power
// into the bulk relative to the plane source (which excites a whole slab).
f_sw  := 440e9 * 2 * pi
B_amp := 500.0
B_ext.setRegion(7, Vector(B_amp*sin(f_sw*t), 0, 0))

// ── Output ──
autosave(m, 5e-11)       // OVF snapshot every 50 ps
tableautosave(1e-11)     // table.txt every 10 ps
TableAdd(E_Total)

run(0.3e-9)
